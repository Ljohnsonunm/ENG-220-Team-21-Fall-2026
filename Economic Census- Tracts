from google.colab import files

uploaded = files.upload()

import zipfile
import os

% Get uploaded ZIP filename
zip_name = next(iter(uploaded))

% Extract files
with zipfile.ZipFile(zip_name, "r") as zip_ref:
    zip_ref.extractall("USDA_Food_Access")

% Display extracted files
print(os.listdir("USDA_Food_Access"))
import pandas as pd

% Read USDA documentation
readme = pd.read_csv("USDA_Food_Access/ReadMe.csv")
variable_lookup = pd.read_csv("USDA_Food_Access/VariableLookup.csv")

% Display documentation
print("USDA README:")
display(readme)

print("USDA VARIABLE LOOKUP:")
display(variable_lookup)

% Load the main USDA dataset
food_access = pd.read_csv(
    "USDA_Food_Access/Food Access Research Atlas.csv"
)

% Check dataset dimensions
print("Dataset dimensions:", food_access.shape)

% Check the state names in the dataset
print("State values:")
print(food_access["State"].unique())

% Check the county names
print("\nCounty values:")
print(
    food_access[
        food_access["State"].str.contains("New Mexico|NM", case=False, na=False)
    ]["County"].unique())

% Filter USDA data for Sandoval County, New Mexico
sandoval_data = food_access[
    (food_access["State"] == "New Mexico") &
    (food_access["County"] == "Sandoval County")
].copy()

% Check filtered dataset
print("Sandoval County dataset dimensions:", sandoval_data.shape)

display(sandoval_data.head())

% Display all Sandoval County census tract numbers
print(sandoval_data["CensusTract"].tolist())

import geopandas as gpd

% Download 2010 Census geographic boundaries
tract_url = "https://www2.census.gov/geo/tiger/TIGER2010/TRACT/2010/tl_2010_35_tract10.zip"

cousub_url = "https://www2.census.gov/geo/tiger/TIGER2010/COUSUB/2010/tl_2010_35_cousub10.zip"

% Read geographic files
tracts = gpd.read_file("zip+" + tract_url)
county_subdivisions = gpd.read_file("zip+" + cousub_url)

% Inspect Cuba county subdivision names
print(
    county_subdivisions[
        county_subdivisions["NAME10"].str.contains(
            "Cuba", case=False, na=False
        )
    ][["NAME10", "GEOID10"]]
)

% Get Cuba CCD boundary
cuba_boundary = county_subdivisions[
    county_subdivisions["GEOID10"] == "3504390870"
].copy()

% Make sure both geographic datasets use the same coordinate system
tracts = tracts.to_crs(cuba_boundary.crs)

% Find census tracts that intersect Cuba CCD
cuba_tracts = gpd.sjoin(
    tracts,
    cuba_boundary[["geometry"]],
    how="inner",
    predicate="intersects"
)

% Display matching census tracts
print("Census tracts intersecting Cuba CCD:", len(cuba_tracts))

display(cuba_tracts[["GEOID10", "NAME10"]])

% Convert census tract IDs to strings for matching
cuba_tract_ids = cuba_tracts["GEOID10"].astype(str)

sandoval_data["CensusTract"] = (
    sandoval_data["CensusTract"].astype(str)
)

% Keep only Sandoval County tracts intersecting Cuba CCD
cuba_food_access = sandoval_data[
    sandoval_data["CensusTract"].isin(cuba_tract_ids)
].copy()

% Display results
print("Matching USDA census tracts:", len(cuba_food_access))

display(cuba_food_access[["CensusTract", "State", "County"]])

% Search USDA variable lookup for food-access indicators
food_variables = variable_lookup[
    variable_lookup["LongName"].str.contains(
        "low access|low income|supermarket|vehicle",
        case=False,
        na=False
    )
]

display(food_variables)

% Select food-access indicators
selected_columns = [
    "CensusTract",
    "County",
    "LILATracts_1And10",
    "LILATracts_Vehicle",
    "HUNVFlag",
    "TractHUNV",
    "TractSNAP"
]

% Create a smaller analysis dataset
food_access_analysis = cuba_food_access[selected_columns].copy()

% Display results
display(food_access_analysis)

% Save selected food-access data
food_access_analysis.to_csv(
    "Cuba_CCD_Food_Access_Cleaned.csv",
    index=False
)

print("Cleaned food-access dataset saved successfully!")
import matplotlib.pyplot as plt

